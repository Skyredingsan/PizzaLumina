APP_NAME=PizzaLumina
APP_ENV=local
APP_KEY=placekeyrhere
APP_DEBUG=true
APP_URL="http://localhost:${NGINX_PORT}"

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- БД: креды берём из корневого .env (один источник истины) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE="${POSTGRES_DB}"
DB_USERNAME="${POSTGRES_USER}"
DB_PASSWORD="${POSTGRES_PASSWORD}"

# --- Тестовая БД (создаётся вручную: см. README) ---
DB_TEST_DATABASE=pizzalumina_test

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- RabbitMQ (для очередей) ---
QUEUE_CONNECTION=sync
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER="${RABBITMQ_USER}"
RABBITMQ_PASSWORD="${RABBITMQ_PASSWORD}"

# --- Сессии и кеш ---
SESSION_DRIVER=redis
CACHE_STORE=redis

# --- Тесты ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- MinIO (S3-совместимое хранилище для отчётов Stage 8) ---
MINIO_ACCESS_KEY="${MINIO_ROOT_USER}"
MINIO_SECRET_KEY="${MINIO_ROOT_PASSWORD}"
MINIO_BUCKET=pizzalumina-reports
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# AWS S3 compatibility (flysystem-aws-s3-v3 читает AWS_* переменные)
AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=pizzalumina-reports
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Почта (заглушка — пишет в storage/logs/laravel.log) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@pizzalumina.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- JWT (для этапа 4: авторизация) ---
# Сгенерировать: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_SHOW_BLACKLIST_EXCEPTION=true

# --- Product cache ---
PRODUCT_CACHE_LIST_TTL=3600
PRODUCT_CACHE_ITEM_TTL=3600
PRODUCT_MAX_PER_PAGE=100

# --- Report (Stage 8) ---
REPORT_QUEUE_CONNECTION=rabbitmq
REPORT_QUEUE_NAME=reports.generate
REPORT_COMPLETED_QUEUE_NAME=reports.completed
REPORT_DOWNLOAD_URL_EXPIRES=5
